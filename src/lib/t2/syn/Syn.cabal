cabal-version:  3.4
name:           Syn
version:        0.0.0
build-type:     Simple

library
    ghc-options:        -Wall
    hs-source-dirs:     .
    exposed-modules:    Syn
    other-modules:      Internal.Ast,
                        Internal.Parser,
                        Internal.Parsers,
                        Internal.Guards
    build-depends:      base ^>= 4.20,
                        text ^>= 2.1,
                        Common,
                        Lex
    default-language:   Haskell2010
    default-extensions: OverloadedStrings,
                        TupleSections,
                        LambdaCase