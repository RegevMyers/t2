cabal-version:  3.4
name:           Gen
version:        0.0.0
build-type:     Simple

library
    ghc-options:        -Wall
    hs-source-dirs:     .
    exposed-modules:    Gen
    other-modules:      Internal.Generator,
                        Internal.Register,
                        Internal.X86_64.Generator,
                        Internal.X86_64.Registers
    build-depends:      base ^>= 4.20,
                        text ^>= 2.1,
                        containers ^>= 0.7,
                        mtl ^>= 2.3.1,
                        Common,
                        Syn
    default-language:   Haskell2010
    default-extensions: OverloadedStrings,
                        TupleSections,
                        LambdaCase,
                        DeriveDataTypeable,
                        DefaultSignatures,
                        GADTs